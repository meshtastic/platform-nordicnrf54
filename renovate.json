{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["custom.regex"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Framework and bootloader tag pins in platform.json",
      "managerFilePatterns": ["/^platform\\.json$/"],
      "matchStrings": [
        "https://github\\.com/(?<depName>meshtastic/nRF54_(?:Arduino|Bootloader))\\.git#(?<currentValue>v[\\d.]+)"
      ],
      "datasourceTemplate": "github-tags"
    }
  ]
}
